<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="690.0" prefWidth="900.0" style="-fx-background-color: #EEF3F5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.view.CustomerView">
   <children>
      <Label alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="110.0" prefWidth="900.0" style="-fx-background-color: #12343B; -fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;" text="CUSTOMER PAGE" />
      <Label fx:id="lblWelcome" alignment="CENTER" layoutX="0.0" layoutY="72.0" prefHeight="24.0" prefWidth="900.0" style="-fx-text-fill: #A9C2C6; -fx-font-size: 14px;" text="Welcome" />
      <Button fx:id="btnLogout" layoutX="770.0" layoutY="30.0" mnemonicParsing="false" onAction="#onLogout" prefHeight="34.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-border-color: white; -fx-border-radius: 8; -fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;" text="Log out" />

      <Pane layoutX="40.0" layoutY="140.0" prefHeight="530.0" prefWidth="820.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 14, 0, 0, 4);">
         <children>
            <TableView fx:id="tblAccounts" layoutX="30.0" layoutY="24.0" prefHeight="190.0" prefWidth="760.0" style="-fx-font-size: 13px;">
               <columns>
                  <TableColumn fx:id="colAccNo" prefWidth="150.0" text="Account no" />
                  <TableColumn fx:id="colType" prefWidth="200.0" text="Type" />
                  <TableColumn fx:id="colStatus" prefWidth="180.0" text="Status" />
                  <TableColumn fx:id="colBalance" prefWidth="230.0" text="Balance" />
               </columns>
            </TableView>

            <Label layoutX="30.0" layoutY="236.0" style="-fx-text-fill: #12292F; -fx-font-size: 14px; -fx-font-weight: bold;" text="Amount" />
            <TextField fx:id="txtAmount" layoutX="30.0" layoutY="260.0" prefHeight="36.0" prefWidth="200.0" promptText="Enter amount" style="-fx-background-color: white; -fx-border-color: #8FA1A8; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px; -fx-padding: 0 12 0 12;" />

            <Label layoutX="260.0" layoutY="236.0" style="-fx-text-fill: #12292F; -fx-font-size: 14px; -fx-font-weight: bold;" text="Transfer to" />
            <ComboBox fx:id="cmbTransferTo" layoutX="260.0" layoutY="260.0" prefHeight="36.0" prefWidth="260.0" promptText="Choose an account" style="-fx-font-size: 14px;" />

            <Button fx:id="btnDeposit" layoutX="30.0" layoutY="318.0" mnemonicParsing="false" onAction="#onDeposit" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Deposit" />
            <Button fx:id="btnWithdraw" layoutX="190.0" layoutY="318.0" mnemonicParsing="false" onAction="#onWithdraw" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Withdraw" />
            <Button fx:id="btnTransfer" layoutX="350.0" layoutY="318.0" mnemonicParsing="false" onAction="#onTransfer" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Transfer" />
            <Button fx:id="btnHistory" layoutX="510.0" layoutY="318.0" mnemonicParsing="false" onAction="#onHistory" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: white; -fx-border-color: #0F766E; -fx-border-radius: 8; -fx-text-fill: #0F766E; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="History" />
            <Button fx:id="btnProfile" layoutX="670.0" layoutY="318.0" mnemonicParsing="false" onDragDetected="#onProfile" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #0F766E; -fx-border-radius: 8; -fx-text-fill: #0F766E; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="Profile" />

            <Label fx:id="lblMessage" layoutX="30.0" layoutY="376.0" prefHeight="24.0" prefWidth="760.0" style="-fx-text-fill: #4F636A; -fx-font-size: 14px;" text="Select an account in the table, then choose an action." />

            <TextArea fx:id="txtOutput" editable="false" layoutX="30.0" layoutY="408.0" prefHeight="100.0" prefWidth="760.0" promptText="History and profile details appear here" style="-fx-font-size: 13px;" wrapText="true" />
         </children>
      </Pane>
   </children>
</Pane>

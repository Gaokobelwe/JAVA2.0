<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.Pane?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="762.0" style="-fx-background-color: #EEF3F5;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank.view.LoginView">
   <fx:define>
      <ToggleGroup fx:id="roleGroup" />
   </fx:define>
   <children>
      <Label alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="110.0" prefWidth="762.0" style="-fx-background-color: #12343B; -fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;" text="BANKING SYSTEM" />
      <Label alignment="CENTER" layoutX="0.0" layoutY="72.0" prefHeight="24.0" prefWidth="762.0" style="-fx-text-fill: #A9C2C6; -fx-font-size: 14px;" text="Log in to continue" />

      <Pane layoutX="156.0" layoutY="150.0" prefHeight="310.0" prefWidth="450.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 14, 0, 0, 4);">
         <children>
            <Label layoutX="40.0" layoutY="24.0" style="-fx-text-fill: #12292F; -fx-font-size: 14px; -fx-font-weight: bold;" text="Log in as" />
            <RadioButton fx:id="rbBanker" layoutX="40.0" layoutY="52.0" mnemonicParsing="false" style="-fx-font-size: 14px; -fx-text-fill: #12292F;" text="Banker">
               <toggleGroup>
                  <ToggleGroup fx:id="roleGroup" />
               </toggleGroup></RadioButton>
            <RadioButton fx:id="rbCustomer" layoutX="150.0" layoutY="52.0" mnemonicParsing="false" selected="true" style="-fx-font-size: 14px; -fx-text-fill: #12292F;" text="Customer" toggleGroup="$roleGroup" />

            <Label layoutX="40.0" layoutY="98.0" style="-fx-text-fill: #12292F; -fx-font-size: 14px; -fx-font-weight: bold;" text="UserName" />
            <TextField fx:id="txtUsername" layoutX="40.0" layoutY="122.0" prefHeight="36.0" prefWidth="370.0" promptText="Enter your email" style="-fx-background-color: white; -fx-border-color: #8FA1A8; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px; -fx-padding: 0 12 0 12;" />

            <Label layoutX="40.0" layoutY="172.0" style="-fx-text-fill: #12292F; -fx-font-size: 14px; -fx-font-weight: bold;" text="OTP" />
            <TextField fx:id="txtOtp" layoutX="40.0" layoutY="196.0" prefHeight="36.0" prefWidth="370.0" promptText="Enter the code sent to your email" style="-fx-background-color: white; -fx-border-color: #8FA1A8; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px; -fx-padding: 0 12 0 12;" />

            <Button fx:id="btnLogin" layoutX="40.0" layoutY="254.0" mnemonicParsing="false" onAction="#onLogin" prefHeight="42.0" prefWidth="370.0" style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="LogIn" />
         </children>
      </Pane>
   </children>
</Pane>
